rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "REPLACE_WITH_ADMIN_UID"
      ];
    }

    match /albums/{childId}/{month}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
